; Engine configuration file.
; Edit through the Godot editor where possible.
;
; Ashes of the Sky — Flight Prototype

config_version=5

[application]

config/name="Ashes of the Sky"
run/main_scene="res://world/test/flight_test.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]

flight_pitch_up={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
flight_pitch_down={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}
flight_yaw_left={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
flight_yaw_right={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
flight_accelerate={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325), Object(InputEventJoypadMotion,"axis":5,"axis_value":1.0)]
}
flight_decelerate={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326), Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0)]
}
flight_boost={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"button_index":0)]
}
camera_look={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2), Object(InputEventJoypadButton,"button_index":10)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"button_index":2)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":6)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.095, 0.13, 1)
